NEXTAUTH_URL=http://localhost:4002

# You can use openssl to generate a random 32 character key: openssl rand -base64 32
NEXTAUTH_SECRET=
# ^ DELIBERATELY EMPTY. This previously carried a real 32-byte secret inherited
# from boxyhq/saas-starter-kit when it was vendored at RELAY-1 — a value published in a
# public repository. NEXTAUTH_SECRET signs session JWTs, so a known value lets anyone
# forge a session cookie for any user. It was live in .env until RELAY-58 rotated it.
 
# SMTP / Email settings 
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# If you are using Docker, you can retrieve the values from: docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

APP_URL=http://localhost:4002


GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RETRACED_URL=
RETRACED_API_KEY=
RETRACED_PROJECT_ID=

# Hide landing page and redirect to login page
HIDE_LANDING_PAGE=false

# SSO groups can be prefixed with this identifier in order to avoid conflicts with other groups.
# For example boxyhq-admin would be resolved to admin, boxyhq-member would be resolved to member, etc.
GROUP_PREFIX=boxyhq-

# Users will need to confirm their email before accessing the app feature
CONFIRM_EMAIL=false

# Disable non-business email signup
DISABLE_NON_BUSINESS_EMAIL_SIGNUP=false

# Mixpanel
NEXT_PUBLIC_MIXPANEL_TOKEN=

# If you want to use Jackson that is self-hosted or our SaaS instead of the embedded Jackson that comes with SaaS Starter Kit
# JACKSON_URL=http://localhost:5225
# JACKSON_EXTERNAL_URL=https://sso.eu.boxyhq.com
# JACKSON_API_KEY=secret
# JACKSON_PRODUCT_ID=boxyhq
# JACKSON_WEBHOOK_SECRET=your-webhook-secret

# Enable Auth providers (comma separated)
# Supported providers: github, google, saml, email, credentials, idp-initiated
AUTH_PROVIDERS=

# OpenTelemetry
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_HEADERS=
# OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=grpc
# If you have any issues with using the otel exporter and want to enable debug logs uncomment below
# OTEL_EXPORTER_DEBUG=true 
OTEL_PREFIX=boxyhq.saas

NEXT_PUBLIC_TERMS_URL='/terms'
NEXT_PUBLIC_PRIVACY_URL='/privacy'

NEXT_PUBLIC_DARK_MODE=false

# Team feature
FEATURE_TEAM_SSO=true
FEATURE_TEAM_DSYNC=true
FEATURE_TEAM_AUDIT_LOG=true
FEATURE_TEAM_API_KEY=true
FEATURE_TEAM_DELETION=true
FEATURE_TEAM_PAYMENTS=true

# Google reCAPTCHA
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Decide which session strategy (jwt or database) to use with NextAuth
NEXTAUTH_SESSION_STRATEGY=jwt

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACE_SAMPLE_RATE=0.0 # https://develop.sentry.dev/sdk/performance/#tracessamplerate
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=

# Sentry CLI (Set these values if you want to upload source maps to Sentry)
SENTRY_URL=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Max login attempts before account is locked
MAX_LOGIN_ATTEMPTS=5

# Set this to receive Slack notifications, https://hooks.slack.com/services/xxx/xxx/xxx
SLACK_WEBHOOK_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Single flat n8n-wedge tier Payment Link (test mode only).
# Created by `node --env-file .env scripts/create-n8n-wedge-price.mjs`, which
# prints the exact value to set here. Leave blank to hide the button.
NEXT_PUBLIC_N8N_WEDGE_PAYMENT_LINK=

# Support URL
NEXT_PUBLIC_SUPPORT_URL=

# ─── Relay additions ─────────────────────────────────────────────────────────
# Empty on purpose. Each needs a real account; a fabricated value fails at runtime
# in a way that looks like a code bug, so leave it blank until it is issued.
UPSTASH_QSTASH_URL=
UPSTASH_QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
RELAY_API_SECRET=
SENTRY_DSN=
# [RELAY-5] How long the consumer waits for a customer destination before recording the
# attempt as a timeout. Blank is safe here, unlike the credentials above: it falls back to
# 10000ms in lib/relay/forward.ts. Keep it well under the platform's function timeout, or
# the invocation is killed before the failure can be written to DeliveryLog.
RELAY_FORWARD_TIMEOUT_MS=

# ── [RELAY-59] Destination auth headers — encryption key at rest ─────────────────
# AES-256-GCM key used to encrypt customer-configured destination auth headers before
# they reach `Route.destinationHeadersEncrypted`. 32 bytes, hex (64 chars) or base64
# (44 chars) — `openssl rand -hex 32` is the canonical form.
#
# EMPTY DELIBERATELY. There is NO default. If absent:
#   - any route created WITHOUT destination headers works (the encrypt path is never hit)
#   - any route created WITH destination headers fails loudly with a 500, which is the
#     right behaviour — a silent no-op write would be a credential loss
#   - any consumer hitting a route that HAS headers fails FAILED rather than retrying,
#     which keeps a poisoned row from getting retried forever
#
# Generation is one shell command and rotation is described in
# `lib/relay/destinationAuth.ts`. Never commit the value; never echo it to a log.
RELAY_DESTINATION_HEADERS_KEY=

# ── [RELAY-39] Non-bypass runtime role ──────────────────────────────────────
# The role the app connects as once RLS covers the Prisma path. Same host and
# database as DATABASE_URL — only the ROLE differs. `relay_app` is
# rolbypassrls=f, so RELAY-11's policies apply to it; `postgres` is
# rolbypassrls=t and silently bypasses every one of them.
#
# EMPTY DELIBERATELY. Generate a password and set it out of band:
#   ALTER ROLE relay_app WITH PASSWORD '<generated>';
# Never commit the value. Supavisor takes custom roles as `<role>.<project_ref>`
# (verified against the hosted pooler on both :5432 and :6543).
RELAY_APP_DATABASE_URL=

# Local equivalent, for running __tests__/lib/rls.spec.ts against the local
# stack: postgresql://relay_app:<password>@127.0.0.1:54322/postgres
RELAY_APP_DATABASE_URL_LOCAL=
