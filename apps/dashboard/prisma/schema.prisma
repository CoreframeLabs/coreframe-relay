generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OWNER
  MEMBER
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                     String    @id @default(uuid())
  name                   String
  email                  String    @unique
  emailVerified          DateTime?
  password               String?
  image                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now())
  invalid_login_attempts Int       @default(0)
  lockedAt               DateTime?

  teamMembers TeamMember[]
  accounts    Account[]
  sessions    Session[]
  invitations Invitation[]
}

model Team {
  id              String       @id @default(uuid())
  name            String
  slug            String       @unique
  domain          String?      @unique
  defaultRole     Role         @default(MEMBER)
  billingId       String?
  billingProvider String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now())
  members         TeamMember[]
  invitations     Invitation[]
  apiKeys         ApiKey[]

  // ── Relay [RELAY-2] ──
  routes           Route[]
  gateRules        GateRule[]
  approvalRequests ApprovalRequest[]
  auditLogs        AuditLog[]

  @@index([billingId])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model Invitation {
  id             String   @id @default(uuid())
  teamId         String
  email          String?
  role           Role     @default(MEMBER)
  token          String   @unique
  expires        DateTime
  invitedBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())
  sentViaEmail   Boolean  @default(true)
  allowedDomains String[] @default([])

  user User @relation(fields: [invitedBy], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, email])
  @@index([email])
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
}

model ApiKey {
  id         String    @id @default(uuid())
  name       String
  teamId     String
  hashedKey  String    @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now())
  expiresAt  DateTime?
  lastUsedAt DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

model Subscription {
  id         String    @id
  customerId String
  priceId    String
  active     Boolean   @default(false)
  startDate  DateTime
  endDate    DateTime
  cancelAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now())

  @@index([customerId])
}

model Service {
  id          String   @id @default(uuid())
  description String
  features    String[]
  image       String
  name        String
  created     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  Price       Price[]
}

model Price {
  id            String   @id @default(uuid())
  billingScheme String
  currency      String
  serviceId     String
  amount        Int?
  metadata      Json
  type          String
  created       DateTime

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model jackson_store {
  key        String    @id(map: "_jackson_store_key") @db.VarChar(1500)
  value      String
  iv         String?   @db.VarChar(64)
  tag        String?   @db.VarChar(64)
  createdAt  DateTime  @default(now()) @db.Timestamp(6)
  modifiedAt DateTime? @db.Timestamp(6)
  namespace  String?   @db.VarChar(256)

  jackson_index jackson_index[]

  @@index([namespace], map: "_jackson_store_namespace")
  @@ignore
}

model jackson_index {
  id       Int    @id(map: "_jackson_index_id") @default(autoincrement())
  key      String @db.VarChar(1500)
  storeKey String @db.VarChar(1500)

  store jackson_store @relation(fields: [storeKey], references: [key], onDelete: Cascade, onUpdate: NoAction)

  @@index([key], map: "_jackson_index_key")
  @@index([key, storeKey], map: "_jackson_index_key_store")
  @@ignore
}

model jackson_ttl {
  key       String @id(map: "jackson_ttl_key") @db.VarChar(1500)
  expiresAt BigInt

  @@index([expiresAt], map: "_jackson_ttl_expires_at")
  @@ignore
}

// ═══════════════════════════════════════════════════════════════════
// RELAY — added in [RELAY-2] on top of the BoxyHQ base schema.
// Source of truth: relay-boilerplate-integration.md Part 3.
//
// Three deliberate deviations from that spec, all index/type level. Rationale is
// in the dev log; summarised at each site below.
//   1. Timestamps are `@db.Timestamptz(6)`. Prisma's bare `DateTime` maps to
//      `timestamp(3)` WITHOUT a timezone. Relay records when a webhook was
//      received and delivered across regions — a naive timestamp makes latency
//      and ordering wrong the moment anything runs outside UTC.
//   2. Composite indexes replace some single-column ones. Every real query is
//      "rows for THIS route/team, newest first"; equality column first, range
//      column last, per the leftmost-prefix rule.
//   3. The spec's `@@index([requestId])` on DeliveryLog is dropped — the field
//      is already `@unique`, which creates that index. Declaring both builds and
//      maintains a second identical index on a high-write table for nothing.
// ═══════════════════════════════════════════════════════════════════

enum RouteStatus {
  ACTIVE
  PAUSED
  FAILING
}

enum DeliveryStatus {
  QUEUED
  DELIVERED
  RETRYING
  FAILED
  DLQ
}

/// An inbound webhook endpoint. `slug` is the public URL segment:
/// POST /in/:teamSlug/:routeSlug/:ingestToken   ([RELAY-57] — the URL is the credential)
model Route {
  id          String      @id @default(uuid())
  teamId      String
  name        String
  slug        String
  destination String
  maxRetries  Int         @default(7)
  status      RouteStatus @default(ACTIVE)
  /// Per-route ingest credential ([RELAY-57]). Stripe/Shopify/GitHub/Meta cannot set a
  /// custom header, so the token IS the endpoint: `…/in/:teamSlug/:routeSlug/:ingestToken`.
  /// 24 random bytes, base64url (192-bit entropy, URL-safe) — Stripe-style bearer-in-URL.
  /// Written by the app at create/rotate time; backfilled by `ingestToken_backfill()`,
  /// a migration-installed plpgsql function (crypto is not expressible as a Prisma
  /// `@default`). `digest()` @-mentions a reserved builtin, hence a named function.
  /// Never a Prisma default: `default(uuid())` would create the SHARED-secret failure
  /// mode — every route accepting the same token.
  /// The unique constraint doubles as the rotation index — proxies accept by path
  /// token, never by scanning.
  ingestToken String       @unique
  /// Customer-configured auth headers for the destination ([RELAY-59]), encrypted at
  /// rest with the app-level `RELAY_DESTINATION_HEADERS_KEY`. Shape: a JSON map of
  /// header name → per-value AES-256-GCM envelope (`{ iv, ct, tag }`, base64), produced
  /// by `lib/relay/destinationAuth.ts`. NOT decrypted until `qstash.ts` is about to
  /// forward, and NEVER returned from an API in any form — a set-value only ever comes
  /// back as its name. A DB dump alone therefore yields no usable customer token.
  /// Threat model + key rotation live on the writer/reader in
  /// `lib/relay/destinationAuth.ts` — do not re-derive it here.
  ///
  /// NULL rather than a default so a route with no headers configured carries no crypto
  /// material at all, and a decryption bug never fires on a route that has nothing to
  /// protect.
  destinationHeadersEncrypted Json?
  createdAt                    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt                    DateTime      @updatedAt @db.Timestamptz(6)

  team         Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  deliveryLogs DeliveryLog[]
  dlqItems     DlqItem[]

  // The unique constraint already indexes (teamId, slug), which covers the
  // "list routes for a team" query by leftmost prefix. A bare @@index([teamId])
  // would be redundant with it.
  @@unique([teamId, slug])
}

/// Append-only record of one delivery attempt chain. The highest-write table in
/// the system — one row per inbound webhook — so indexes here are kept to the
/// ones that serve a real query.
model DeliveryLog {
  id           String         @id @default(uuid())
  routeId      String
  /// Value of the relay-request-id header. Unique, which is what makes retries
  /// idempotent: a replayed QStash message hits this constraint instead of
  /// double-writing.
  requestId    String         @unique
  sourceIp     String?
  status       DeliveryStatus @default(QUEUED)
  attemptCount Int            @default(0)
  responseCode Int?
  latencyMs    Int?
  payloadSizeB Int?
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)
  deliveredAt  DateTime?      @db.Timestamptz(6)

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  /// Serves the log feed: one route, newest first. Replaces the spec's separate
  /// @@index([routeId]) and @@index([createdAt]) — neither alone can answer it
  /// without a bitmap combine or a sort.
  @@index([routeId, createdAt(sort: Desc)])
  /// Serves the status filter chips on the feed (Success / Retry / Failed).
  @@index([routeId, status, createdAt(sort: Desc)])
}

/// A permanently failed delivery, retained for replay. Written rarely, read on
/// one page, and reaped on a schedule.
model DlqItem {
  id           String    @id @default(uuid())
  routeId      String
  requestId    String
  failReason   String
  attemptCount Int
  /// Stored inline only under 64KB; larger bodies go to object storage and this
  /// stays null with `payloadKey` set.
  payload      Json?
  payloadKey   String?
  /// Retention by tier: Free now+7d, Pro now+30d, Business now+90d.
  expiresAt    DateTime  @db.Timestamptz(6)
  retriedAt    DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  /// The DLQ page: one route, newest first.
  @@index([routeId, createdAt(sort: Desc)])
  /// The retention reaper scans this alone, across all routes.
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────
// RELAY: GATE (Phase 2 — models land now so one migration covers it)
// ─────────────────────────────────────────────────────────────────

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  TIMED_OUT
}

model GateRule {
  id          String    @id @default(uuid())
  teamId      String
  name        String
  description String?
  /// e.g. { field: "amount", op: "gt", value: 100 }
  condition   Json
  riskLevel   RiskLevel @default(MEDIUM)
  timeoutMins Int       @default(60)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  team             Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  approvalRequests ApprovalRequest[]

  /// Rule evaluation loads the ACTIVE rules for one team and sits in the hot path
  /// of every gated webhook. Composite, equality-only — a true partial index
  /// (WHERE active) would be tighter, but Prisma cannot declare one, so that would
  /// have to be hand-written into the migration and would then drift from schema.
  @@index([teamId, active])
}

model ApprovalRequest {
  id           String         @id @default(uuid())
  teamId       String
  gateRuleId   String
  requestId    String         @unique
  payload      Json
  status       ApprovalStatus @default(PENDING)
  riskLevel    RiskLevel
  approvedBy   String?
  rejectedBy   String?
  resolvedAt   DateTime?      @db.Timestamptz(6)
  expiresAt    DateTime       @db.Timestamptz(6)
  /// Correlates back to the Inngest run that is waiting on this decision.
  inngestRunId String?
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)

  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  gateRule GateRule @relation(fields: [gateRuleId], references: [id])

  /// The approvals inbox: one team, filtered by status, newest first.
  @@index([teamId, status, createdAt(sort: Desc)])
  /// The timeout sweeper.
  @@index([expiresAt])
  @@index([gateRuleId])
}

// ─────────────────────────────────────────────────────────────────
// RELAY: AUDIT LOG — replaces Retraced, and the backing store for
// lib/audit.ts, whose recordAuditEvent() has been logging since [RELAY-1].
// ─────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  teamId    String
  /// User email, or "system" for machine-initiated events.
  actor     String
  /// e.g. "route_created", "payload_approved".
  event     String
  /// e.g. a route id or a request id.
  target    String?
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt(sort: Desc)])
  @@index([teamId, event, createdAt(sort: Desc)])
}
